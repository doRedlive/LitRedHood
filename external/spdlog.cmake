if (TARGET spdlog::spdlog)
    target_link_libraries(litredhood_external INTERFACE spdlog::spdlog)
elseif (EXISTS "${CMAKE_CURRENT_LIST_DIR}/spdlog/CMakeLists.txt")
    set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_EXAMPLE_HO OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_BENCH OFF CACHE BOOL "" FORCE)
    set(SPDLOG_BUILD_SHARED OFF CACHE BOOL "" FORCE)
    set(SPDLOG_INSTALL OFF CACHE BOOL "" FORCE)
    add_subdirectory(${CMAKE_CURRENT_LIST_DIR}/spdlog EXCLUDE_FROM_ALL)
    target_link_libraries(litredhood_external INTERFACE spdlog::spdlog)
else ()
    find_package(spdlog QUIET)
    if (spdlog_FOUND)
        target_link_libraries(litredhood_external INTERFACE spdlog::spdlog)
    else ()
        message(FATAL_ERROR "spdlog not found: please add external/spdlog submodule or install spdlog package.")
    endif ()
endif ()
